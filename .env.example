# Copy this file to .env and replace credentials with your local values.
# Never commit .env or real credentials.

# For Python running directly on the host:
MILVUS_URI=http://localhost:19530
MINIO_ENDPOINT=localhost:9000
MINIO_URI=http://localhost:9000

# For Docker Compose, set these to the service/container DNS name and port
# reachable from the shared Docker network, e.g. http://milvus-standalone:19530.
# MILVUS_URI=http://milvus-standalone:19530
# MINIO_ENDPOINT=minio:9000
# MINIO_URI=http://minio:9000

COLLECTION_NAME_IMAGE=search_image_to_image_collection
COLLECTION_NAME_TEXT=images_clip_collection
VECTOR_DIM_IMAGE=2048
VECTOR_DIM_TEXT=512
MODEL_NAME_IMAGE=resnet50
MODEL_NAME_TEXT=ViT-B/32

# Use dedicated local development credentials; do not use production secrets.
MINIO_ACCESS_KEY=replace_with_local_minio_access_key
MINIO_SECRET_KEY=replace_with_local_minio_secret_key
MINIO_BUCKET=images-upload-minio

# Optional path to your local image dataset used by ingestion scripts.
# Defaults to ./data/images when omitted.
IMAGE_DATA_DIR=./data/images
